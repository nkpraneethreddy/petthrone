# Public origin used for Stripe redirects, sitemap, and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required to take real payments. Checkout is refused without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Used only for live board refresh when a bid lands.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
